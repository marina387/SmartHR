SMARTHR_SECRET_KEY=replace-with-a-long-random-secret
SMARTHR_DATABASE=data/smarthr.db
SMARTHR_DOCUMENTS=data/documents
SMARTHR_LOG_DIR=data/logs
CHAT_MODEL_PATH=models/chat_model
CHAT_MODEL_DEVICE=auto
CHAT_MODEL_MAX_TOKENS=512
CHAT_MODEL_TEMPERATURE=0.2
RAG_BACKEND=auto
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_ALLOW_MODEL_DOWNLOAD=0

# Временная зона календаря и показателей
SMARTHR_TIMEZONE=Asia/Yekaterinburg
